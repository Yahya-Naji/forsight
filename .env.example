# ─── Supabase ──────────────────────────────────────────────────────────
# Project URL is safe to expose; the two keys are not equal in power.
SUPABASE_URL=https://YOURPROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOURPROJECT.supabase.co

# service_role ("secret") key — the pipeline and /api/generate only.
# Bypasses RLS. Never expose to a browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_KEY=

# anon ("publishable") key — safe in the browser. SELECT-only via the
# policies in migration 010.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Direct Postgres, used only by pipeline/apply_migrations.py.
# Take the SESSION POOLER string from Supabase → Connect: the apex
# db.<ref>.supabase.co host is IPv6-only and will hang on most networks.
SUPABASE_DB_URL=postgresql://postgres.YOURREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ─── LLM · Azure OpenAI (Responses API) ────────────────────────────────
# DEPLOYMENT is the deployment NAME you created in Azure AI Foundry, not a
# model id — a resource with no deployment returns 404 for every model name.
AZURE_OPENAI_ENDPOINT=https://YOURRESOURCE.cognitiveservices.azure.com
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o             # reasoning: synthesis, generation
AZURE_OPENAI_DEPLOYMENT_FAST=gpt-4o-mini   # high volume: extraction, entailment
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# ─── Optional ──────────────────────────────────────────────────────────
# Site-scoped search for Lane B's Tier 1/2 rows. Without it Lane B still
# runs GDELT; the nine search-method sources are skipped with a log line.
SERPER_API_KEY=

# Lets the console dispatch a run to GitHub Actions. Unset → the
# pipeline_runs row stays QUEUED and the UI says so rather than faking a run.
GH_TOKEN=
GH_REPO=owner/repo
GH_WORKFLOW=pipeline.yml
GH_REF=main
